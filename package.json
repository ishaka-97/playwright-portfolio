{
  "name": "playwright-portfolio",
  "version": "1.0.0",
  "description": "Framework d'automatisation de tests E2E avec Playwright + TypeScript (Page Object Model, CI GitHub Actions)",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:chromium": "playwright test --project=chromium",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "author": "Siaka KONE",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
